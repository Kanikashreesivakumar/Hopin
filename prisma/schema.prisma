generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ride {
  id           String   @id @default(cuid())
  eventName    String
  date         String
  time         String
  status       String   @default("pending")
  driverName   String
  driverRating Float
  cost         Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  driver       Driver   @relation(fields: [driverId], references: [id])
  driverId     String
}

model Driver {
  id          String      @id @default(cuid())
  name        String
  phone       String
  rating      Float
  carDetails  CarDetails?
  rides       Ride[]
}

model CarDetails {
  id          String   @id @default(cuid())
  make        String
  model       String
  color       String
  plateNumber String
  driver      Driver   @relation(fields: [driverId], references: [id])
  driverId    String   @unique
}